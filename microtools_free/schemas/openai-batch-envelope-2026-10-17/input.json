{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brookmasonangel/microtools-free/main/microtools_free/schemas/openai-batch-envelope-2026-10-17/input.json",
  "title": "BatchContractCheck openai-batch-envelope-2026-10-17: input",
  "description": "A dated envelope profile; body objects are opaque and API acceptance is not established.",
  "type": "object",
  "required": [
    "custom_id",
    "method",
    "url",
    "body"
  ],
  "properties": {
    "custom_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "const": "POST"
    },
    "url": {
      "enum": [
        "/v1/responses",
        "/v1/chat/completions",
        "/v1/embeddings",
        "/v1/completions",
        "/v1/moderations",
        "/v1/images/generations",
        "/v1/images/edits",
        "/v1/videos"
      ]
    },
    "body": {
      "type": "object"
    }
  }
}
